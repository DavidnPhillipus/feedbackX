VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local dev: leave VITE_API_URL / VITE_SOCKET_URL empty — Vite proxies to the API.
# If port 8080 is busy, point the proxy elsewhere:
# VITE_PROXY_TARGET=http://localhost:8081
#
# Production (Render static site): set both to your API service URL, no trailing slash
# VITE_API_URL=https://feedbackx-api.onrender.com
# VITE_SOCKET_URL=https://feedbackx-api.onrender.com
