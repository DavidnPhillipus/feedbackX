# ── Supabase Postgres (required) ────────────────────────────────────────────
# Use Session pooler URI (port 5432) from Supabase → Project Settings → Database.
# Prefer Session mode over Transaction (6543) so Prisma migrations work.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=15&connection_limit=5&pool_timeout=20"
#
# If migrate/deploy fails with P1001, try the Direct connection URI instead:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
#
# Free-tier projects pause after inactivity — wake them in the Supabase dashboard.

# ── Auth / server (required) ────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
PORT=8080
# Exact frontend origin(s). Comma-separated if you have more than one.
# On Render: https://feedbackx-web.onrender.com
CLIENT_URL="http://localhost:5173"

# ── Supabase Storage (required in production) ───────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# ── Optional public URL for local /uploads fallback (Render sets RENDER_EXTERNAL_URL)
# PUBLIC_BASE_URL="https://feedbackx-api.onrender.com"

# ── Optional: create admin on first seed (npm run db:seed) ──────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_NAME="Admin"

# ── Email (Resend — required for password reset in production) ──────────────
RESEND_API_KEY="re_your_api_key"
# During onboarding use onboarding@resend.dev; after verifying a domain, use your own
RESEND_FROM="feedbackX <onboarding@resend.dev>"

# Optional SMTP fallback (used only when RESEND_API_KEY is not set)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="feedbackX <noreply@example.com>"
